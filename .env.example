# Copia este archivo a .env.local para trabajar en local.
# En Vercel, estas variables se configuran en Project → Settings → Environment Variables.

# Supabase (proyecto "portfolio"). Ambos valores son PÚBLICOS: van al navegador
# y la seguridad la ponen las políticas RLS de la base de datos.
# Supabase → Project Settings → API Keys → "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA pongas aquí la clave secret / service_role ni le añadas el prefijo NEXT_PUBLIC_.

# Indexación en buscadores. Déjalo vacío o en false mientras la web está en obras.
# Ponlo a true SOLO en el entorno de Producción de Vercel cuando quieras que Google la indexe.
NEXT_PUBLIC_SITE_INDEXABLE=
