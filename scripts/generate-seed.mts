/**
 * Generates supabase/seed/portfolio_seed.sql from supabase/seed/content.ts.
 * Run: npm run seed:sql   (Node >= 22.6, uses native type stripping)
 * The SQL is idempotent (upserts by natural key) and never deletes rows.
 */
import { writeFileSync } from "node:fs";
import { capabilities, experience, projects, site, tech } from "../supabase/seed/content.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "boolean") return v ? "true" : "false";
  if (typeof v === "number") return String(v);
  return `'${String(v).replace(/'/g, "''")}'`;
};
const arr = (a: string[] | undefined) => (a && a.length ? `array[${a.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;

const out: string[] = [
  "-- Generated by scripts/generate-seed.mts — do not edit by hand.",
  "-- Idempotent: upserts by natural key, never deletes.",
  "begin;",
  "",
];

// site_content
out.push(
  `insert into public.site_content (key, locale, value, published) values ('site', 'en', ${json(site)}, true), ('capabilities', 'en', ${json(capabilities)}, true)`,
  "on conflict (key, locale) do update set value = excluded.value, published = excluded.published;",
  ""
);

// projects
for (const p of projects) {
  out.push(
    `insert into public.projects (slug, title, sector, summary, status, status_note, role, tier, sort_order, stack, tags, context, problem, solution, architecture, integrations, highlights, verification, url, links, internal_link, cover_image, cover_alt, featured, published) values (` +
      [
        q(p.slug), q(p.title), q(p.sector), q(p.summary), q(p.status), q(p.statusNote ?? null), q(p.role), q(p.tier), q(p.sortOrder),
        arr(p.stack), arr(p.cardTags), q(p.context ?? null), q(p.problem ?? null), q(p.solution ?? null),
        arr(p.architecture), arr(p.integrations), arr(p.highlights), arr(p.verification),
        q(p.url ?? null), json(p.links ?? []), q(p.internalLink ?? null), q(p.cover?.path ?? null), q(p.cover?.alt ?? null),
        q(p.tier === "featured"), "true",
      ].join(", ") +
      ")",
    "on conflict (slug) do update set title = excluded.title, sector = excluded.sector, summary = excluded.summary, status = excluded.status, status_note = excluded.status_note, role = excluded.role, tier = excluded.tier, sort_order = excluded.sort_order, stack = excluded.stack, tags = excluded.tags, context = excluded.context, problem = excluded.problem, solution = excluded.solution, architecture = excluded.architecture, integrations = excluded.integrations, highlights = excluded.highlights, verification = excluded.verification, url = excluded.url, links = excluded.links, internal_link = excluded.internal_link, cover_image = excluded.cover_image, cover_alt = excluded.cover_alt, featured = excluded.featured, published = excluded.published;"
  );
}
out.push("");

// technologies
tech.forEach((g, gi) =>
  g.items.forEach((t, ti) =>
    out.push(
      `insert into public.technologies (name, category, category_order, sort_order, icon, published) values (${q(t.name)}, ${q(g.group)}, ${gi * 10}, ${ti * 10}, ${q(t.icon ?? null)}, true) on conflict (category, name) do update set category_order = excluded.category_order, sort_order = excluded.sort_order, icon = excluded.icon, published = excluded.published;`
    )
  )
);
out.push("");

// experience (natural key: id text stored in tags[1] is avoided; use title+place)
out.push("-- experience: replaced only for rows created by this seed (marked with tag 'seed')");
for (const e of experience) {
  const type = e.kind === "education" ? "formacion" : "trabajo";
  out.push(
    `insert into public.experience (title, place, period, description, tags, type, kind, bullets, icon, pending_confirmation, sort_order, published) select ${q(e.title)}, ${q(e.organization)}, ${q(e.period)}, ${q(e.summary)}, array['seed', ${q(e.id)}]::text[], ${q(type)}, ${q(e.kind)}, ${e.bullets ? json(e.bullets) : "null"}, ${q(e.icon)}, ${q(!!e.pendingConfirmation)}, ${e.sortOrder}, true where not exists (select 1 from public.experience where tags @> array['seed', ${q(e.id)}]::text[]);`,
    `update public.experience set title = ${q(e.title)}, place = ${q(e.organization)}, period = ${q(e.period)}, description = ${q(e.summary)}, type = ${q(type)}, kind = ${q(e.kind)}, bullets = ${e.bullets ? json(e.bullets) : "null"}, icon = ${q(e.icon)}, pending_confirmation = ${q(!!e.pendingConfirmation)}, sort_order = ${e.sortOrder}, published = true where tags @> array['seed', ${q(e.id)}]::text[];`
  );
}

out.push("", "commit;", "");
writeFileSync(new URL("../supabase/seed/portfolio_seed.sql", import.meta.url), out.join("\n"));
console.log(`seed written: ${projects.length} projects, ${experience.length} experience items, ${tech.reduce((n, g) => n + g.items.length, 0)} technologies`);
